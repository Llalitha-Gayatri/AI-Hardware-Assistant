# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=*

# AI / LLM Configuration
# Supported providers: "mock", "openai", "gemini", "groq", "anthropic"
# Default is "mock" for seamless offline development and testing
LLM_PROVIDER=mock

# API Keys (leave empty or set when using actual providers)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Hardware Execution Settings
COMMAND_TIMEOUT_SECONDS=5
ALLOW_DMIDECODE=true
